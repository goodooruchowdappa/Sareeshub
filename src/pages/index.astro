---
import Layout from "../layouts/Layout.astro";
import ShopCardC from "../components/ShopCard.astro";
import ProductCardC from "../components/ProductCard.astro";
import ServiceDown from "../components/ServiceDown.astro";
import { load } from "../lib/server";
import { SHOP_KINDS, SITE } from "../lib/config";
import { absoluteUrl, mediaUrl } from "../lib/format";
import type { ProductCard, ShopCard } from "../lib/types";

type Home = {
  featured: ShopCard[];
  latest: ProductCard[];
  tags: { slug: string; name: string; category: string; count: number }[];
  stats: { shops: number; weavers: number; sarees: number; cities: number };
};
const { data, error } = await load<Home>("get_home");
if (error) Astro.response.status = 503;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: absoluteUrl("/"),
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: absoluteUrl("/sarees?q={search_term_string}") },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: absoluteUrl("/"),
    logo: absoluteUrl("/icons/icon-512.png"),
  },
];
---

<Layout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} path="/" jsonLd={jsonLd}>
  {!data ? <ServiceDown /> : (
    <>
      <section class="relative overflow-hidden border-b border-line bg-[radial-gradient(ellipse_at_top_right,var(--color-zari-100),transparent_55%),linear-gradient(to_bottom,var(--color-sand),var(--color-cream))]">
        <div class="container-x relative grid gap-10 pb-8 pt-7 sm:py-14 lg:grid-cols-[1.15fr_1fr] lg:items-center">
          <div class="min-w-0">
            <h1 class="text-[2.1rem] leading-[1.08] text-brand-900 min-[380px]:text-4xl sm:text-5xl lg:text-6xl">
              Every saree shop and weaver, on one map.
            </h1>
            <p class="mt-3 max-w-xl text-base text-muted sm:mt-4 sm:text-lg">
              Find pure pattu, Kanchipuram, Banarasi and handloom sarees near you. Call, WhatsApp or walk in — you deal with the seller directly.
            </p>
            <form action="/sarees" method="get" role="search" class="mt-5 flex max-w-xl gap-2 rounded-2xl border border-line bg-white p-1.5 shadow-[var(--shadow-card)] sm:mt-6">
              <label for="home-q" class="sr-only">What are you looking for?</label>
              <svg viewBox="0 0 24 24" class="ml-2 h-5 w-5 shrink-0 self-center text-muted" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
              <input id="home-q" name="q" type="search" required placeholder="Pure pattu, bridal, Dharmavaram…" class="min-w-0 flex-1 bg-transparent px-1 text-base outline-none" />
              <button class="btn-primary" type="submit">Search</button>
            </form>
            <div class="mt-3 grid max-w-xl grid-cols-2 gap-2 sm:mt-4 sm:flex sm:flex-wrap">
              <a href="/map?near=1" class="btn-gold !py-3 sm:!py-2.5">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg>
                Shops near me
              </a>
              <a href="/map" class="btn-outline !py-3 sm:!py-2.5">Open the map</a>
            </div>
          </div>

          {/* The memorable bit: sarees fanned out on the counter, the way a shopkeeper shows them. */}
          {data.latest.length >= 3 && (
            <a href="/sarees" class="group relative mx-auto hidden h-[430px] w-full max-w-[460px] lg:block" aria-label="Browse sarees">
              {data.latest.slice(0, 3).map((p, i) => (
                <figure
                  class="absolute bottom-14 left-1/2 w-[200px] origin-bottom overflow-hidden rounded-xl bg-white p-1.5 shadow-xl shadow-ink/15 ring-1 ring-line transition duration-500 group-hover:shadow-2xl"
                  style={`transform: translateX(-50%) rotate(${(i - 1) * 13}deg) translateY(${i === 1 ? -14 : 0}px); z-index:${i === 1 ? 3 : 1}`}
                >
                  <img src={mediaUrl(p.image, "thumb") ?? undefined} alt="" width="360" height="480" class="aspect-[3/4] w-full rounded-lg bg-sand object-cover" loading="eager" />
                </figure>
              ))}
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-ink px-4 py-1.5 text-sm font-semibold text-cream shadow">
                {data.stats.sarees.toLocaleString("en-IN")} sarees from {data.stats.shops.toLocaleString("en-IN")} sellers
              </span>
            </a>
          )}
        </div>
      </section>

      <section class="container-x pt-6 sm:pt-8" aria-label="Browse">
        <div class="scroller sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0">
          {SHOP_KINDS.slice(0, 3).map((k) => (
            <a href={`/map?kind=${k.value}`} class="chip shrink-0 snap-start !border-brand-200 !bg-brand-50 !py-1.5 !text-sm !text-brand-800">{k.plural}</a>
          ))}
          {data.tags.slice(0, 14).map((t) => <a class="chip shrink-0 snap-start !py-1.5 !text-sm" href={`/collections/${t.slug}`}>{t.name}</a>)}
        </div>
      </section>

      <section class="container-x pt-8 sm:pt-12" aria-labelledby="feat-h">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 id="feat-h" class="text-2xl sm:text-3xl">Shops & weavers</h2>
            <p class="text-sm text-muted sm:text-base">Photos, reviews and directions for every seller.</p>
          </div>
          <a href="/map" class="shrink-0 text-sm font-semibold text-brand-700 hover:underline">See all on map</a>
        </div>
        {data.featured.length === 0 ? (
          <div class="card mt-6 p-8 text-center">
            <p class="font-display text-xl">Be the first shop on Sarees Hub</p>
            <p class="mt-1 text-muted">New shops appear here as soon as they're approved.</p>
            <a class="btn-primary mt-4" href="/seller/register">Register your shop</a>
          </div>
        ) : (
          <div class="scroller mt-4 sm:mx-0 sm:mt-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-4">
            {data.featured.map((s, i) => <div class="w-[72%] shrink-0 snap-start min-[480px]:w-[45%] sm:w-auto [&>a]:h-full"><ShopCardC shop={s} eager={i < 2} /></div>)}
          </div>
        )}
      </section>

      {data.latest.length > 0 && (
        <section class="container-x pt-10 sm:pt-14" aria-labelledby="new-h">
          <div class="flex items-end justify-between gap-4">
            <div>
              <h2 id="new-h" class="text-2xl sm:text-3xl">Just added</h2>
              <p class="text-sm text-muted sm:text-base">New sarees from shops and looms.</p>
            </div>
            <a href="/sarees?sort=newest" class="shrink-0 text-sm font-semibold text-brand-700 hover:underline">Browse all</a>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-x-3 gap-y-5 sm:mt-6 sm:grid-cols-3 sm:gap-x-4 lg:grid-cols-6 max-sm:[&>*:nth-child(n+7)]:hidden">
            {data.latest.map((p) => <ProductCardC product={p} />)}
          </div>
          <a href="/sarees" class="btn-outline mt-5 w-full sm:hidden">See all sarees</a>
        </section>
      )}

      <section class="container-x pt-10 sm:pt-14" aria-labelledby="custom-h">
        <div class="grid gap-4 overflow-hidden rounded-2xl border border-zari-300 bg-zari-100/60 p-5 sm:grid-cols-[1fr_auto] sm:items-center sm:p-7">
          <div class="min-w-0">
            <h2 id="custom-h" class="text-2xl">Can't find the exact saree?</h2>
            <p class="mt-1 max-w-2xl text-muted">Send a photo and your budget. Shops and weavers near you reply with their own photos and prices. Your first request is free.</p>
          </div>
          <a href="/requests/new" class="btn-primary !py-3">Request a custom saree</a>
        </div>
      </section>

      <section class="container-x pt-10 sm:pt-14" aria-labelledby="how-h">
        <h2 id="how-h" class="text-2xl sm:text-3xl">How it works</h2>
        <ol class="mt-4 grid gap-3 sm:mt-6 md:grid-cols-3 md:gap-4">
          {[
            { t: "Find", d: "Search by fabric, weave or place, or open the map to see who's near you — in India or abroad." },
            { t: "Talk", d: "Call or WhatsApp the shop. Ask for photos, prices and availability." },
            { t: "Visit or order", d: "Get directions, or ask them to courier. Then leave a review for other buyers." },
          ].map((s, i) => (
            <li class="flex gap-4 rounded-2xl border border-line bg-white p-4 sm:p-5 md:flex-col md:gap-2">
              <span class="font-display text-4xl leading-none text-zari-500 md:text-5xl">{i + 1}</span>
              <div>
                <h3 class="text-lg sm:text-xl">{s.t}</h3>
                <p class="mt-0.5 text-sm text-muted">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="container-x pt-10 sm:pt-14">
        <div class="flex flex-col gap-4 rounded-2xl bg-ink p-6 text-cream sm:flex-row sm:items-center sm:justify-between sm:p-8">
          <div>
            <h2 class="text-2xl text-cream">Own a saree shop or loom?</h2>
            <p class="mt-1 text-cream/75">List your shop free. Buyers nearby find you on the map and call you directly.</p>
          </div>
          <a href="/seller/register" class="btn-gold shrink-0 !py-3">Register your shop</a>
        </div>
      </section>
    </>
  )}
</Layout>
