---
import Layout from "../layouts/Layout.astro";
import ShopCardC from "../components/ShopCard.astro";
import ProductCardC from "../components/ProductCard.astro";
import ServiceDown from "../components/ServiceDown.astro";
import { load } from "../lib/server";
import { SHOP_KINDS, SITE } from "../lib/config";
import { absoluteUrl } from "../lib/format";
import type { ProductCard, ShopCard } from "../lib/types";

type Home = {
  featured: ShopCard[];
  latest: ProductCard[];
  tags: { slug: string; name: string; category: string; count: number }[];
  stats: { shops: number; weavers: number; sarees: number; cities: number };
};
const { data, error } = await load<Home>("get_home");
if (error) Astro.response.status = 503;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: absoluteUrl("/"),
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: absoluteUrl("/sarees?q={search_term_string}") },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: absoluteUrl("/"),
    logo: absoluteUrl("/icons/icon-512.png"),
  },
];
const kindIcons: Record<string, string> = {
  shop: "🏬", weaver: "🧵", cooperative: "🤝", manufacturer: "🏭", wholesaler: "📦", showroom: "✨", boutique: "🪡",
};
---

<Layout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} path="/" jsonLd={jsonLd}>
  {!data ? <ServiceDown /> : (
    <>
      <section class="relative overflow-hidden border-b border-line bg-[radial-gradient(ellipse_at_top_right,var(--color-zari-100),transparent_55%),radial-gradient(ellipse_at_bottom_left,var(--color-brand-50),transparent_60%),linear-gradient(to_bottom,var(--color-sand),var(--color-cream))]">
        <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-zari-300/30 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-brand-200/40 blur-3xl" aria-hidden="true"></div>
        <div class="container-x relative grid gap-10 py-12 sm:py-16 lg:grid-cols-[1.2fr_1fr] lg:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-zari-700">Shops · Weavers · Wholesalers</p>
            <h1 class="mt-3 text-4xl leading-[1.05] text-brand-900 sm:text-5xl lg:text-6xl">
              Every saree shop and weaver, <span class="italic text-brand-600">on one map.</span>
            </h1>
            <p class="mt-4 max-w-xl text-lg text-muted">
              Find pure pattu, semi pattu, Kanchipuram, Banarasi and handloom sarees near you — then call, WhatsApp or
              get directions straight to the seller.
            </p>
            <form action="/sarees" method="get" role="search" class="mt-6 flex max-w-xl gap-2 rounded-2xl border border-line bg-white p-1.5 shadow-[var(--shadow-card)]">
              <label for="home-q" class="sr-only">What are you looking for?</label>
              <input id="home-q" name="q" type="search" required placeholder="Try “pure pattu bridal” or “Dharmavaram”" class="min-w-0 flex-1 bg-transparent px-3 text-base outline-none" />
              <button class="btn-primary" type="submit">Search</button>
            </form>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href="/map?near=1" class="btn-gold">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg>
                Shops near me
              </a>
              <a href="/map" class="btn-outline">Open the map</a>
              <a href="/requests" class="btn-ghost">📸 Request a custom saree</a>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[
              { n: data.stats.shops, l: "shops & weavers listed" },
              { n: data.stats.sarees, l: "sarees to browse" },
              { n: data.stats.weavers, l: "handloom weavers & co-ops" },
              { n: data.stats.cities, l: "towns & cities" },
            ].map((s) => (
              <div class="card p-5">
                <p class="font-display text-4xl text-brand-700">{s.n.toLocaleString("en-IN")}</p><div class="mt-2 h-0.5 w-10 rounded-full bg-gradient-to-r from-zari-500 to-peacock-500"></div>
                <p class="mt-1 text-sm text-muted">{s.l}</p>
              </div>
            ))}
            <div class="col-span-2 rounded-2xl bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 p-5 text-cream shadow-lg shadow-brand-900/20 ring-1 ring-zari-500/30">
              <p class="font-display text-xl">Own a saree shop or loom?</p>
              <p class="mt-1 text-sm text-cream/80">Put your shop on the map for free and get calls from nearby buyers.</p>
              <a href="/seller/register" class="btn mt-3 bg-cream text-brand-800 hover:bg-white">Register your shop →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="container-x pt-10" aria-labelledby="custom-h">
        <div class="flex flex-col gap-4 rounded-2xl border border-zari-300 bg-gradient-to-r from-zari-100 to-cream p-5 sm:flex-row sm:items-center sm:p-6">
          <div class="min-w-0 flex-1">
            <h2 id="custom-h" class="text-2xl">Can't find the exact saree?</h2>
            <p class="mt-1 text-muted">Upload a photo, set your budget, and verified shops and weavers near you reply with their own photos and prices. First request free.</p>
          </div>
          <a href="/requests/new" class="btn-primary shrink-0">Request a custom saree</a>
        </div>
      </section>

      {data.tags.length > 0 && (
        <section class="container-x pt-10" aria-labelledby="tags-h">
          <h2 id="tags-h" class="text-2xl">Popular right now</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {data.tags.map((t) => <a class="chip !py-1.5 !text-sm" href={`/collections/${t.slug}`}>{t.name}{t.count > 0 && <span class="text-muted">· {t.count}</span>}</a>)}
          </div>
        </section>
      )}

      <section class="container-x pt-12" aria-labelledby="feat-h">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 id="feat-h" class="text-3xl">Shops & weavers</h2>
            <p class="text-muted">Trusted sellers with photos, reviews and directions.</p>
          </div>
          <a href="/map" class="hidden text-sm font-semibold text-brand-700 hover:underline sm:block">See all on the map →</a>
        </div>
        {data.featured.length === 0 ? (
          <div class="card mt-6 p-8 text-center">
            <p class="font-display text-xl">Be the first shop on Sarees Hub</p>
            <p class="mt-1 text-muted">New shops appear here as soon as they're approved.</p>
            <a class="btn-primary mt-4" href="/seller/register">Register your shop</a>
          </div>
        ) : (
          <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {data.featured.map((s, i) => <ShopCardC shop={s} eager={i < 4} />)}
          </div>
        )}
      </section>

      {data.latest.length > 0 && (
        <section class="container-x pt-14" aria-labelledby="new-h">
          <div class="flex items-end justify-between gap-4">
            <div>
              <h2 id="new-h" class="text-3xl">Just added</h2>
              <p class="text-muted">Fresh sarees from shops and looms.</p>
            </div>
            <a href="/sarees?sort=newest" class="text-sm font-semibold text-brand-700 hover:underline">Browse all →</a>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
            {data.latest.map((p) => <ProductCardC product={p} />)}
          </div>
        </section>
      )}

      <section class="container-x pt-14" aria-labelledby="types-h">
        <h2 id="types-h" class="text-3xl">Who would you like to visit?</h2>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
          {SHOP_KINDS.map((k) => (
            <a href={`/map?kind=${k.value}`} class="card flex flex-col items-center gap-2 p-4 text-center hover:border-brand-200">
              <span class="text-3xl" aria-hidden="true">{kindIcons[k.value]}</span>
              <span class="text-sm font-semibold">{k.plural}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="container-x pt-14">
        <div class="grid gap-4 md:grid-cols-3">
          {[
            { t: "Find", d: "Search by fabric, weave or place, or open the map to see who's near you — in India or abroad." },
            { t: "Talk", d: "Call or WhatsApp the shop directly. Ask for photos, prices and availability. No middlemen." },
            { t: "Visit", d: "Get turn-by-turn directions, then leave a review to help other buyers." },
          ].map((s, i) => (
            <div class="card p-6">
              <p class="font-display text-5xl text-zari-500">{i + 1}</p>
              <h3 class="mt-2 text-xl">{s.t}</h3>
              <p class="mt-1 text-sm text-muted">{s.d}</p>
            </div>
          ))}
        </div>
      </section>
    </>
  )}
</Layout>
