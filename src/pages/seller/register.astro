---
import Layout from "../../layouts/Layout.astro";
import SellerRegister from "../../components/islands/SellerRegister";
---
<Layout title="Register your saree shop" description="Add your saree shop, loom or showroom to Sarees Hub for free." noindex>
  <section class="container-x max-w-4xl py-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-zari-700">Free listing</p>
    <h1 class="mt-1 text-3xl sm:text-4xl">Register your shop</h1>
    <p class="mt-2 text-muted">Takes about 5 minutes. Our team checks every listing — usually within a day — and then your pin goes live on the map.</p>
    <div class="mt-6"><SellerRegister client:only="react" /></div>
  </section>
</Layout>
