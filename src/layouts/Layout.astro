---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Logo from "../components/Logo.astro";
import AccountMenu from "../components/islands/AccountMenu";
import { SITE } from "../lib/config";
import { PUBLIC_CONTACT_EMAIL, PUBLIC_SUPABASE_URL } from "astro:env/client";

export interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string | null;
  imageAlt?: string;
  type?: "website" | "article" | "product" | "profile";
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Full-height app layout (map, dashboards): no footer, body doesn't scroll. */
  app?: boolean;
  hideFooter?: boolean;
}
const { app = false, hideFooter = false, ...seo } = Astro.props;
// Pages can pass their own mobile bottom bar (e.g. Call / WhatsApp on a shop); otherwise the tab bar shows.
const ownBar = Astro.slots.has("bottombar");
const tabs = [
  { href: "/", label: "Home", match: (p: string) => p === "/", icon: "M3 11 12 4l9 7M5 10v10h5v-6h4v6h5V10" },
  { href: "/map", label: "Map", match: (p: string) => p.startsWith("/map") || p.startsWith("/shops"), icon: "M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" },
  { href: "/sarees", label: "Sarees", match: (p: string) => p.startsWith("/sarees") || p.startsWith("/collections"), icon: "M6 3h12l-2 6 3 12H5l3-12-2-6Zm2 6h8" },
  { href: "/requests", label: "Custom", match: (p: string) => p.startsWith("/requests") || p.startsWith("/account/requests"), icon: "M4 7h4l2-3h4l2 3h4v12H4V7Zm8 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" },
  { href: "/account", label: "Account", match: (p: string) => (p.startsWith("/account") && !p.startsWith("/account/requests")) || p.startsWith("/login") || p.startsWith("/seller"), icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9a8 8 0 0 1 16 0" },
];
const path = Astro.url.pathname;
const nav = [
  { href: "/map", label: "Explore map" },
  { href: "/sarees", label: "Sarees" },
  { href: "/requests", label: "Custom saree" },
  { href: "/sell", label: "Sell on Sarees Hub" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...seo} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href={PUBLIC_SUPABASE_URL} crossorigin />
    <slot name="head" />
  </head>
  <body class:list={[app ? "flex h-dvh flex-col overflow-hidden" : "min-h-dvh flex flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] md:pb-0"]}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
    <div class="border-pattern h-1.5 w-full" aria-hidden="true"></div>
    <header class="sticky top-0 z-50 border-b border-green-700/40 bg-green-700 text-white shadow-lg">
      <div class:list={["flex h-16 items-center gap-2 sm:gap-3", app ? "px-3 sm:px-5" : "container-x"]}>
        <a href="/" aria-label="Sarees Hub home" class="shrink-0"><Logo dark /></a>
        <nav class="ml-4 hidden items-center gap-1 md:flex" aria-label="Main">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                "rounded-lg px-3 py-2 text-sm font-medium text-white/85 hover:bg-white/10 hover:text-white",
                path.startsWith(n.href) && "bg-white/10 !text-gold-300",
              ]}
              aria-current={path.startsWith(n.href) ? "page" : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>
        <form action="/sarees" method="get" role="search" class="ml-auto hidden max-w-xs flex-1 lg:block">
          <label class="sr-only" for="hdr-q">Search sarees</label>
          <input id="hdr-q" name="q" type="search" placeholder="Search pure pattu, Kanchipuram…" class="input !rounded-full !border-white/20 !bg-white/15 !py-2 !text-white placeholder:!text-white/55 focus:!border-gold-300 focus:!ring-gold-300/20" />
        </form>
        <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2 lg:ml-2">
          <AccountMenu client:idle />
          <details class="relative md:hidden" id="nav-menu">
            <summary class="btn !p-2 list-none cursor-pointer text-cream hover:bg-white/10" aria-label="Menu">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <div class="card absolute right-0 z-[60] mt-2 w-56 p-1 text-ink">
              {nav.map((n) => <a href={n.href} class="nav-menu-link block rounded-lg px-3 py-2 text-sm hover:bg-sand">{n.label}</a>)}
              <a href="/seller/register" class="nav-menu-link block rounded-lg px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-sand">Register your shop</a>
            </div>
          </details>
          <script>
            document.querySelectorAll(".nav-menu-link").forEach((el) => {
              el.addEventListener("click", () => {
                const d = document.getElementById("nav-menu") as HTMLDetailsElement | null;
                if (d) d.open = false;
              });
            });
          </script>
        </div>
      </div>
    </header>

    <main id="main" class:list={[app ? "relative min-h-0 flex-1" : "flex-1"]}>
      <slot />
    </main>

    {!app && !hideFooter && (
      <footer class="mt-16 border-t border-green-800 bg-green-800">
        <div class="container-x grid grid-cols-2 gap-x-4 gap-y-8 py-10 lg:grid-cols-4">
          <div class="col-span-2 lg:col-span-1">
            <Logo dark />
            <p class="mt-3 max-w-xs text-sm text-white/60">{SITE.tagline}. Talk to sellers directly — no middlemen, no commission.</p>
          </div>
          <div>
            <h2 class="font-sans text-sm font-semibold text-white">For buyers</h2>
            <ul class="mt-3 space-y-2 text-sm text-white/65">
              <li><a class="hover:text-white hover:underline" href="/map">Saree shops near me</a></li>
              <li><a class="hover:text-white hover:underline" href="/map?kind=weaver">Handloom weavers</a></li>
              <li><a class="hover:text-white hover:underline" href="/collections/pure-pattu">Pure pattu sarees</a></li>
              <li><a class="hover:text-white hover:underline" href="/collections/kanchipuram">Kanchipuram sarees</a></li>
            </ul>
          </div>
          <div>
            <h2 class="font-sans text-sm font-semibold text-white">For sellers</h2>
            <ul class="mt-3 space-y-2 text-sm text-white/65">
              <li><a class="hover:text-white hover:underline" href="/sell">Why list with us</a></li>
              <li><a class="hover:text-white hover:underline" href="/seller/register">Register your shop — free</a></li>
              <li><a class="hover:text-white hover:underline" href="/sell#plans">Plans & pricing</a></li>
              <li><a class="hover:text-white hover:underline" href="/seller">Seller dashboard</a></li>
            </ul>
          </div>
          <div>
            <h2 class="font-sans text-sm font-semibold text-white">Company</h2>
            <ul class="mt-3 space-y-2 text-sm text-white/65">
              <li><a class="hover:text-white hover:underline" href="/about">About</a></li>
              <li><a class="hover:text-white hover:underline" href="/contact">Contact</a></li>
              <li><a class="hover:text-white hover:underline" href="/terms">Terms</a> · <a class="hover:text-white hover:underline" href="/privacy">Privacy</a></li>
              <li><a class="hover:text-white hover:underline" href="/refund-policy">Refunds</a> · <a class="hover:text-white hover:underline" href="/shipping-policy">Delivery</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-green-700">
          <div class="container-x flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-white/50">© {year} Sarees Hub. Map data © OpenStreetMap contributors.</p>
            <div class="flex items-center gap-3">
              {/* WhatsApp Channel */}
              <a href="https://whatsapp.com/channel/0029Vb6k9669WtC9rNabhC3J" target="_blank" rel="noopener noreferrer"
                 aria-label="Follow Sarees Hub on WhatsApp"
                 class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/8 px-3 py-1.5 text-xs font-medium text-white/70 transition hover:bg-white/15 hover:text-white">
                <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
              </a>
              {/* Instagram */}
              <a href="https://www.instagram.com/sarees___hub" target="_blank" rel="noopener noreferrer"
                 aria-label="Follow Sarees Hub on Instagram"
                 class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/8 px-3 py-1.5 text-xs font-medium text-white/70 transition hover:bg-white/15 hover:text-white">
                <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
                Instagram
              </a>
              <a class="text-xs text-white/50 hover:text-white hover:underline" href={`mailto:${PUBLIC_CONTACT_EMAIL}`}>{PUBLIC_CONTACT_EMAIL}</a>
            </div>
          </div>
        </div>
      </footer>
    )}

    <div class:list={["z-50 border-t border-line bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden", app ? "shrink-0" : "fixed inset-x-0 bottom-0"]}>
      {ownBar ? (
        <div class="flex gap-2 px-3 py-2"><slot name="bottombar" /></div>
      ) : (
        <nav aria-label="Main" class="grid h-16 grid-cols-5">
          {tabs.map((t) => {
            const on = t.match(path);
            return (
              <a href={t.href} aria-current={on ? "page" : undefined}
                 class:list={["flex flex-col items-center justify-center gap-0.5 text-[11px] font-medium", on ? "text-green-600" : "text-muted"]}>
                <span class:list={["grid h-7 w-12 place-items-center rounded-full transition", on && "bg-green-50"]}>
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width={on ? 2.2 : 1.8} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon} /></svg>
                </span>
                {t.label}
              </a>
            );
          })}
        </nav>
      )}
    </div>
  </body>
</html>
