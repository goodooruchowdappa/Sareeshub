---
import Layout from "./Layout.astro";
export interface Props { title: string; description: string; path: string; updated?: string }
const { title, description, path, updated } = Astro.props;
---
<Layout title={title} description={description} path={path}>
  <article class="container-x max-w-3xl py-10 [&_h2]:mt-8 [&_h2]:text-2xl [&_li]:my-1 [&_p]:my-3 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_a]:text-brand-700 [&_a]:underline">
    <h1 class="text-4xl">{title}</h1>
    {updated && <p class="text-sm text-muted">Last updated: {updated}</p>}
    <slot />
  </article>
</Layout>
