---
export interface Props { class?: string; withText?: boolean }
const { class: cls = "", withText = true } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2", cls]}>
  <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill="#861a3a" />
    <path d="M11 30c2-9 6-16 13-20 1.8 4.5 3.2 11.5 2.6 20H11z" fill="#fffaf2" />
    <path d="M24 10c3.4 2.6 5.6 9.6 5.6 20h-3c.6-8.5-.8-15.5-2.6-20z" fill="#d4a62a" />
    <path d="M11 30h18.6" stroke="#d4a62a" stroke-width="2.4" stroke-linecap="round" />
    <circle cx="20" cy="20" r="1.6" fill="#861a3a" />
  </svg>
  {withText && (
    <span class="leading-none">
      <span class="block font-display text-[1.25rem] font-semibold text-maroon-800">Sarees Hub</span>
      <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-zari-700">shops · weavers · sarees</span>
    </span>
  )}
</span>
