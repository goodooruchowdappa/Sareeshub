---
import Stars from "./Stars.astro";
import { kindLabel } from "../lib/config";
import { formatKm, mediaUrl, placeLine } from "../lib/format";
import type { ShopCard } from "../lib/types";
export interface Props { shop: ShopCard; eager?: boolean }
const { shop, eager = false } = Astro.props;
const img = mediaUrl(shop.cover, "thumb");
---
<a href={`/shops/${shop.slug}`} class="card group flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden bg-sand">
    {img ? (
      <img src={img} alt={shop.name} loading={eager ? "eager" : "lazy"} decoding="async" width="480" height="360" class="h-full w-full object-cover transition group-hover:scale-[1.03]" />
    ) : (
      <div class="grid h-full place-items-center border-pattern opacity-80"><span class="rounded-full bg-cream/90 px-3 py-1 font-display text-lg text-maroon-800">{shop.name.slice(0, 1)}</span></div>
    )}
    {shop.featured && <span class="badge absolute left-2 top-2 bg-zari-500 text-ink shadow">★ Featured</span>}
    {shop.distance_km != null && <span class="badge absolute right-2 top-2 bg-white/95 text-ink shadow">{formatKm(shop.distance_km)}</span>}
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-3">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-zari-700">{kindLabel(shop.kind)}</p>
    <h3 class="font-display text-lg leading-snug text-ink group-hover:text-maroon-700">{shop.name}</h3>
    <p class="text-sm text-muted">{placeLine(shop)}</p>
    <Stars rating={shop.rating_avg} count={shop.rating_count} />
    {shop.tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1 pt-1">
        {shop.tags.slice(0, 3).map((t) => <span class="rounded-full bg-sand px-2 py-0.5 text-[11px] text-ink">{t}</span>)}
      </div>
    )}
  </div>
</a>
