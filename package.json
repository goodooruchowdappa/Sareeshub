{
  "name": "sarees-hub",
  "version": "1.0.0",
  "description": "Find saree shops, weavers and sarees on a map — Astro + Supabase + Cloudflare Workers + Razorpay",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "test:db": "vitest run tests/db",
    "test:e2e": "python3 tests/e2e/run.py",
    "db:setup-sql": "node scripts/build-setup-sql.mjs",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^7.1.4",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
